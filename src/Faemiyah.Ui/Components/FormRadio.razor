@* A group of radio buttons styled as toggle buttons. *@
@typeparam TItem

@{
    var comparer = EqualityComparer<TItem>.Default;
    var invalidSelection = !Options.Values.Any(v => comparer.Equals(v, SelectedOption!));
}

<div class="fui-radio-group">
    @foreach (var option in Options)
    {
        <label class="fui-toggle-radio">
            <input type="radio" checked="@comparer.Equals(SelectedOption!, option.Value)" name="@_name" value="@option.Key" disabled="@Disabled" @onchange="SelectionChanged">
            <span class="fui-toggle-radio-label @(invalidSelection ? FuiStyle.Error : string.Empty) @(Disabled ? FuiStyle.Disabled : string.Empty) @FuiStyle.GetReminderClass(ComparisonTimeStamp, _updateTimeStamp)" @onclick="UpdateTimestamp">@option.Key</span>
        </label>
    }
</div>

@code
{
    // Radio buttons only work as a group when they share a name.
    private readonly string _name = $"fui-radio-{Guid.NewGuid():N}";
    private DateTime _updateTimeStamp = DateTime.MinValue;

    /// <summary>
    /// The selectable options, keyed by display text.
    /// </summary>
    [Parameter]
    public Dictionary<string, TItem> Options { get; set; } = [];

    /// <summary>
    /// The selected value. The error class is shown when it is not one of the options.
    /// </summary>
    [Parameter]
    public TItem? SelectedOption { get; set; }

    /// <summary>
    /// The reminder class is shown while the value is older than this moment.
    /// </summary>
    [Parameter]
    public DateTime ComparisonTimeStamp { get; set; }

    /// <summary>
    /// Whether the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Invoked when the user selects an option.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnChanged { get; set; }

    private void SelectionChanged(ChangeEventArgs args)
    {
        UpdateTimestamp();

        if (Options.TryGetValue(args.Value as string ?? throw new InvalidOperationException("Unknown type of item found from radio value. Expected string."), out var item))
        {
            OnChanged.InvokeAsync(item);
        }
    }

    private void UpdateTimestamp()
    {
        _updateTimeStamp = DateTime.UtcNow;
    }
}
