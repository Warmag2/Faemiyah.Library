@* A number input with a drop-down of number brackets. Picking a bracket selects its end. *@

<div class="fui-input-wrapper">
    <FormNumber SelectedOption="@_selectedOption" Min="@Min" Max="@Max" Disabled="@Disabled" ComparisonTimeStamp="@ComparisonTimeStamp" OnChanged="OnFormNumberCommit" />

    <button type="button" class="fui-button" disabled="@Disabled" @onclick="Pick">▾</button>

    <div class="fui-picker" style="@FuiStyle.HideElement(_selectionBoxHidden)">
        @foreach (var option in _options)
        {
            var optionToSelect = option.End;
            var active = _selectedOption >= option.Begin && _selectedOption <= option.End;
            <div class="fui-picker-item @(active ? FuiStyle.Active : string.Empty)" @onclick="@(() => SelectOptionManual(optionToSelect))">@option</div>
        }
    </div>
</div>

@code
{
    private int _selectedOption;
    private bool _selectionBoxHidden = true;
    private IReadOnlyList<PickBracket> _options = [];

    /// <summary>
    /// Produces the brackets each time the drop-down opens.
    /// </summary>
    [Parameter]
    public Func<IReadOnlyList<PickBracket>> BracketCreatorDelegate { get; set; } = () => [];

    /// <summary>
    /// Initial value. Only read when the component is initialized.
    /// </summary>
    [Parameter]
    public int SelectedOption { get; set; }

    /// <summary>
    /// Smallest value accepted from typing.
    /// </summary>
    [Parameter]
    public int Min { get; set; }

    /// <summary>
    /// Largest value accepted from typing.
    /// </summary>
    [Parameter]
    public int Max { get; set; }

    /// <summary>
    /// Whether the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// The reminder class is shown while the value is older than this moment.
    /// </summary>
    [Parameter]
    public DateTime ComparisonTimeStamp { get; set; }

    /// <summary>
    /// Invoked when the value changes, and also once during initialization.
    /// </summary>
    [Parameter]
    public EventCallback<int> OnChanged { get; set; }

    /// <summary>
    /// The current value. Setting it closes the drop-down and invokes <see cref="OnChanged"/>.
    /// </summary>
    public int SelectedOptionInternal
    {
        get => _selectedOption;
        set
        {
            _selectedOption = value;
            HideSelectionBox();
            OnChanged.InvokeAsync(value);
        }
    }

    private void OnFormNumberCommit(int value)
    {
        SelectedOptionInternal = value;
    }

    private void Pick()
    {
        if (!_selectionBoxHidden)
        {
            HideSelectionBox();
        }
        else
        {
            _options = BracketCreatorDelegate();
            ShowSelectionBox();
        }
    }

    private void ShowSelectionBox()
    {
        _selectionBoxHidden = false;
    }

    private void HideSelectionBox()
    {
        _selectionBoxHidden = true;
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        SelectedOptionInternal = SelectedOption;
    }

    private void SelectOptionManual(int optionToSelect)
    {
        SelectedOptionInternal = optionToSelect;
    }
}
